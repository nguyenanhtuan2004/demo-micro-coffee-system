generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Read model: aggregated revenue — updated from events only (CQRS)
model RevenueStats {
  id          String   @id @default("singleton")
  totalOrders Int      @default(0)
  totalRevenue Float   @default(0)
  updatedAt   DateTime @updatedAt

  @@map("revenue_stats")
}

// Read model: per-product sales — updated from events only (CQRS)
model ProductStats {
  id          String   @id @default(uuid())
  productId   String   @unique
  name        String
  totalSold   Int      @default(0)
  totalRevenue Float   @default(0)
  updatedAt   DateTime @updatedAt

  @@map("product_stats")
}
